node_modules/
dist/
.eslintcache

# dbt / python
target/
dbt_packages/
__pycache__/
.venv/
*.pyc
logs/

# secrets must never be committed (real values live in AWS Secrets Manager)
.env
.env.*
*.pem
*_rsa
*_rsa.pub
*.p8

# os / editor
.DS_Store
.idea/
.vscode/
