  "defaultDefaultClientScopes": [
    "groups"
  ],
  "defaultOptionalClientScopes": [],
  "groups": [
    {
      "name": "strategy-author",
      "path": "/strategy-author",
      "attributes": {
        "description": [
          "May author and submit strategies for approval (A\u00a759)"
        ]
      }
    },
    {
      "name": "business-approver",
      "path": "/business-approver",
      "attributes": {
        "description": [
          "Business half of the two-person strategy approval"
        ]
      }
    },
    {
      "name": "risk-approver",
      "path": "/risk-approver",
      "attributes": {
        "description": [
          "Risk half of the two-person strategy approval"
        ]
      }
    },
    {
      "name": "admin",
      "path": "/admin",
      "attributes": {
        "description": [
          "Platform administration"
        ]
      }
    },
    {
      "name": "collector",
      "path": "/collector",
      "attributes": {
        "description": [
          "Collections agent using the collector workbench"
        ]
      }
    },
    {
      "name": "ops-admin",
      "path": "/ops-admin",
      "attributes": {
        "description": [
